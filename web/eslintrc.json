{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "angular": "readonly"
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-console": "off",
    "no-var": "off",
    "no-extra-semi": "warn",
    "eqeqeq": "warn",
    "curly": "warn",
    "no-empty": "warn"
  }
}